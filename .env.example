SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Backend only. Never expose this key in HTML or browser JavaScript.
SUPABASE_SECRET_KEY=
# Generate a separate random token for the protected readiness endpoint.
HEALTHCHECK_TOKEN=

# Dashboard login. Signs the session cookie: 32+ random characters.
SESSION_SECRET=
# Demo accounts: the approver can approve/reject RFQs and POs; the viewer is read-only.
DEMO_APPROVER_EMAIL=
DEMO_APPROVER_PASSWORD=
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=
# Optional: bearer token for scripts to create/read requests (it can never approve).
API_TOKEN=
